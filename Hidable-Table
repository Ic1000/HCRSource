local CurrentRooms = workspace:WaitForChild("CurrentRooms") 
local function LoadModel(file, url) 
	if not isfile(file) then 
		writefile(file, game:HttpGet(url)) 
	end 
	return game:GetObjects(getcustomasset(file))[1] 
end 

local function HandleTable(obj) 
	if not (obj:IsA("Model") and obj.Name == "Table") then 
		return 
	end 
	if obj:FindFirstChild("DrawerContainer", true) then 
		return 
	end 
	if obj:FindFirstChild("TableCanBeHided") then 
		return 
	end 
	
	for _, v in ipairs(obj:GetDescendants()) do 
		if v:IsA("BasePart") then 
			v.Transparency = 1 
		end 
	end 
	
	local Model = LoadModel( 
		"TableCanBeHided.txt", 
		"https://raw.githubusercontent.com/lynguyen26031993-design/-u/refs/heads/main/Place_131351567799504_Model_Table_1785589098.txt" 
	) 
	if not Model then 
		return 
	end 
	Model.Name = "TableCanBeHided" 
	Model.Parent = obj 
	if Model.PrimaryPart and obj.PrimaryPart then 
		Model:PivotTo(obj.PrimaryPart.CFrame) 	
	end 
	
	local Players = game:GetService("Players") 
	local LocalPlayer = Players.LocalPlayer 
	local RunService = game:GetService("RunService")
	local TweenService = game:GetService("TweenService")
	
	for _, v in ipairs(Model:GetDescendants()) do 
		if v:IsA("ProximityPrompt") then 
			v.Triggered:Connect(function(player) 
				if player ~= LocalPlayer then 
					return 
				end 
				local char = LocalPlayer.Character 
				if not char then 
					return 
				end 
				
				v.Enabled = false 
				local hum = char:FindFirstChildOfClass("Humanoid") 
				local hrp = char:FindFirstChild("HumanoidRootPart") 
				if not hum or not hrp then 
					v.Enabled = true
					return 
				end 
				
				-- Dịch chuyển nhân vật tức thì vào gầm bàn và khóa góc nhìn
				local cf, size = Model:GetBoundingBox()
				local look = -Model.PrimaryPart.CFrame.LookVector 
				local targetPos = cf.Position + Vector3.new(0, size.Y / 2 - 2.5, 0) + look * 1.5
				
				hrp.CFrame = CFrame.lookAt(targetPos, targetPos + look)
				
				-- Khóa camera tại chỗ
				local cam = workspace.CurrentCamera 
				cam.CameraType = Enum.CameraType.Scriptable 
				local camCon = RunService.RenderStepped:Connect(function() 
					if hrp.Parent then 		
						cam.CFrame = hrp.CFrame + Vector3.new(0, 1, 0)
					end 
				end) 
				
				-- Tắt va chạm phần thân
				for _, obj in ipairs(char:GetDescendants()) do 	
					if obj:IsA("BasePart") then 		
						obj.CanCollide = false 	
					end 
				end 
				
				hrp.Anchored = true 
				
				-- ====== KÍCH HOẠT NGAY LẬP TỨC: HIDING & GOD MODE ======
				char:SetAttribute("Hiding", true)
				
				local collision = char:FindFirstChild("Collision")
				local collisionCrouch = collision and collision:FindFirstChild("CollisionCrouch")
				
				local voidCon = RunService.RenderStepped:Connect(function()
					if hrp then
						-- Đẩy Collision rớt xuống vị trí an toàn (-30 studs) để quái hoàn toàn không quét trúng
						local safeSpoofCF = CFrame.new(hrp.Position.X, hrp.Position.Y - 30, hrp.Position.Z)
						
						hrp.CanCollide = false
						if collision then
							collision.CFrame = safeSpoofCF
							collision.CanCollide = false
						end
						if collisionCrouch then
							collisionCrouch.CFrame = safeSpoofCF
							collisionCrouch.CanCollide = false
						end
					end
				end)
				
				-- Hiển thị hiệu ứng Vignette mờ tối và nút bấm thoát
				local hideClone, buttonClone 
				local exitRequested = false 
				
				pcall(function()
					for _, obj in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do 	
						if obj:IsA("ImageLabel") and obj.Name == "HideVignette" then 
							hideClone = obj:Clone() 
							hideClone.Name = "HideVignetteClone" 		
							hideClone.ImageTransparency = 0 		
							hideClone.Visible = true 		
							hideClone.Parent = obj.Parent 		
						elseif obj:IsA("ImageButton") and obj.Name == "ButtonUnhide" then 
							buttonClone = obj:Clone() 
							buttonClone.Name = "ButtonUnhideClone" 		
							buttonClone.Visible = true 		
							buttonClone.Parent = obj.Parent 		
							buttonClone.MouseButton1Click:Connect(function() 			
								exitRequested = true 		
							end) 	
						end 
					end 
				end)
				
				hrp.Anchored = false 
				
				-- Lắng nghe hành động người chơi muốn ra ngoài (Di chuyển hoặc bấm nút Unhide)
				task.spawn(function()
					while true do
						task.wait(0.1)
						-- Nếu người chơi bấm nút di chuyển (WASD / Joystick) hoặc bấm nút thoát trên UI
						if hum.MoveDirection.Magnitude > 0 or exitRequested then
							break
						end
					end
					
					-- ====== KHI BƯỚC RA: TẮT GOD MODE & KHÔI PHỤC TRẠNG THÁI ======
					if voidCon then
						voidCon:Disconnect()
						voidCon = nil
					end
					
					char:SetAttribute("Hiding", nil) 
					
					if buttonClone then buttonClone:Destroy() end 
					if hideClone then hideClone:Destroy() end 
					
					if collision and hrp then
						collision.CFrame = hrp.CFrame
						collision.CanCollide = true
						if collisionCrouch then
							collisionCrouch.CFrame = hrp.CFrame
							collisionCrouch.CanCollide = true
						end
					end
					
					-- Đẩy nhẹ nhân vật ra phía trước bàn khi bước ra
					local exitGoal = hrp.CFrame + (hrp.CFrame.LookVector * 3.5)
					hrp.CFrame = CFrame.new(exitGoal.Position) * (hrp.CFrame - hrp.Position)
					
					for _, obj in ipairs(char:GetDescendants()) do 	
						if obj:IsA("BasePart") then 		
							obj.CanCollide = true 	
						end 
					end 
					
					if camCon then 	
						camCon:Disconnect() 	
						camCon = nil 
					end 
					
					cam.CameraType = Enum.CameraType.Custom 
					v.Enabled = true 
				end)
			end) 
		end 
	end 
end 

for _, obj in ipairs(CurrentRooms:GetDescendants()) do 
	HandleTable(obj) 
end 

CurrentRooms.DescendantAdded:Connect(HandleTable)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CurrentRooms = workspace:WaitForChild("CurrentRooms")

local MaxLookAngle = 25
local plr = Players.LocalPlayer

local function GetCrouchRemote()
	local remotes = ReplicatedStorage:FindFirstChild("RemotesFolder")
		or ReplicatedStorage:FindFirstChild("EntityInfo")
		or ReplicatedStorage:FindFirstChild("Bricks")
	return remotes and remotes:FindFirstChild("Crouch")
end

local function SetPositionSpoof(char, hrp, hum, enabled)
	local collision = char:FindFirstChild("Collision")
	local collisionCrouch = collision and collision:FindFirstChild("CollisionCrouch")
	local crouchRemote = GetCrouchRemote()

	if enabled then
		char:SetAttribute("Hiding", true)
		if hum then
			hum:SetAttribute("Hiding", true)
		end
		if crouchRemote and crouchRemote:IsA("RemoteEvent") then
			pcall(function()
				crouchRemote:FireServer(true, true)
			end)
		end
		if hrp then
			hrp.CanCollide = false
		end
		if collision then
			collision.CanCollide = false
		end
		if collisionCrouch then
			collisionCrouch.CanCollide = false
		end
	else
		char:SetAttribute("Hiding", nil)
		if hum then
			hum:SetAttribute("Hiding", nil)
		end
		if crouchRemote and crouchRemote:IsA("RemoteEvent") then
			pcall(function()
				crouchRemote:FireServer(false, true)
			end)
		end
		if collision and hrp then
			collision.CFrame = hrp.CFrame
			collision.CanCollide = true
		end
		if collisionCrouch and hrp then
			collisionCrouch.CFrame = hrp.CFrame
			collisionCrouch.CanCollide = true
		end
	end
end

local function setup(window)
	if window:FindFirstChild("HidePrompt") then
		return
	end
	local part = window.PrimaryPart or window:FindFirstChildWhichIsA("BasePart", true)
	if not part then
		return
	end

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "HidePrompt"
	prompt.ActionText = "Hide"
	prompt.ObjectText = "Window"
	prompt.MaxActivationDistance = 7
	prompt.RequiresLineOfSight = false
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt.Parent = part

	prompt.Triggered:Connect(function(player)
		local char = player.Character
		if not char or player ~= plr then return end

		local hum = char:FindFirstChildOfClass("Humanoid")
		local hrp = char:FindFirstChild("HumanoidRootPart")
		local head = char:FindFirstChild("Head")
		if not hum or not hrp or not head then return end

		if prompt:GetAttribute("Playing") then return end
		prompt:SetAttribute("Playing", true)
		prompt.Enabled = false

		-- Đứng ở đâu thì khóa đứng im ngay chỗ đó, không dịch chuyển đi đâu cả
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		hrp.Anchored = true

		for _, obj in ipairs(char:GetDescendants()) do
			if obj:IsA("BasePart") then
				obj.CanCollide = false
			end
		end

		-- Bật ngay lập tức attribute Hiding & Position Spoof kiểu Main.luau.txt
		SetPositionSpoof(char, hrp, hum, true)

		local collision = char:FindFirstChild("Collision")
		local collisionCrouch = collision and collision:FindFirstChild("CollisionCrouch")

		local spoofCon
		spoofCon = RunService.RenderStepped:Connect(function()
			if char:GetAttribute("Hiding") == true and hrp and hrp.Parent then
				local spoofCF = CFrame.new(hrp.Position.X, hrp.Position.Y - 30, hrp.Position.Z)
				hrp.CanCollide = false
				if collision then
					collision.CFrame = spoofCF
					collision.CanCollide = false
				end
				if collisionCrouch then
					collisionCrouch.CFrame = spoofCF
					collisionCrouch.CanCollide = false
				end
			end
		end)

		-- Giới hạn góc nhìn nhẹ quanh hướng hiện tại
		local cam = workspace.CurrentCamera
		local prevCamType = cam.CameraType
		cam.CameraType = Enum.CameraType.Scriptable
		local baseLook = hrp.CFrame.LookVector
		local yaw, pitch = 0, 0
		local function clamp(x, a, b)
			return math.max(a, math.min(b, x))
		end

		local lookCon
		lookCon = RunService.RenderStepped:Connect(function()
			if hrp and hrp.Parent and head and head.Parent then
				local delta = UserInputService:GetMouseDelta()
				yaw = clamp(yaw - delta.X * 0.2, -MaxLookAngle, MaxLookAngle)
				pitch = clamp(pitch - delta.Y * 0.2, -MaxLookAngle, MaxLookAngle)
				local origin = head.Position
				local dirCF = CFrame.lookAt(origin, origin + baseLook)
					* CFrame.Angles(0, math.rad(yaw), 0)
					* CFrame.Angles(math.rad(pitch), 0, 0)
				cam.CFrame = dirCF
			end
		end)

		-- Hiệu ứng Vignette và nút thoát nếu có trong PlayerGui
		local hideClone, buttonClone
		local exitRequested = false

		pcall(function()
			for _, obj in ipairs(plr.PlayerGui:GetDescendants()) do
				if obj:IsA("ImageLabel") and obj.Name == "HideVignette" then
					hideClone = obj:Clone()
					hideClone.Name = "HideVignetteClone"
					hideClone.ImageTransparency = 0
					hideClone.Visible = true
					hideClone.Parent = obj.Parent
				elseif obj:IsA("ImageButton") and obj.Name == "ButtonUnhide" then
					buttonClone = obj:Clone()
					buttonClone.Name = "ButtonUnhideClone"
					buttonClone.Visible = true
					buttonClone.Parent = obj.Parent
					buttonClone.MouseButton1Click:Connect(function()
						exitRequested = true
					end)
				end
			end
		end)

		task.spawn(function()
			task.wait(0.15)
			while char.Parent and hrp.Parent and char:GetAttribute("Hiding") == true do
				task.wait(0.05)
				if hum.MoveDirection.Magnitude > 0 or exitRequested then
					break
				end
			end

			if lookCon then lookCon:Disconnect() end
			if spoofCon then spoofCon:Disconnect() end
			if buttonClone then buttonClone:Destroy() end
			if hideClone then hideClone:Destroy() end

			SetPositionSpoof(char, hrp, hum, false)

			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
			hrp.Anchored = false

			for _, obj in ipairs(char:GetDescendants()) do
				if obj:IsA("BasePart") then
					obj.CanCollide = true
				end
			end

			cam.CameraType = prevCamType == Enum.CameraType.Scriptable and Enum.CameraType.Custom or prevCamType
			prompt:SetAttribute("Playing", nil)
			prompt.Enabled = true
		end)
	end)
end

for _, v in ipairs(CurrentRooms:GetDescendants()) do
	if v:IsA("Model") and v.Name == "Window" then
		setup(v)
	end
end

CurrentRooms.DescendantAdded:Connect(function(v)
	if v:IsA("Model") and v.Name == "Window" then
		setup(v)
	end
end)

local CurrentRooms = workspace:WaitForChild("CurrentRooms") 
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local function LoadModel(file, url) 
	if not isfile(file) then 
		writefile(file, game:HttpGet(url)) 
	end 
	return game:GetObjects(getcustomasset(file))[1] 
end 

local function GetCrouchRemote()
	local remotes = ReplicatedStorage:FindFirstChild("RemotesFolder")
		or ReplicatedStorage:FindFirstChild("EntityInfo")
		or ReplicatedStorage:FindFirstChild("Bricks")
	return remotes and remotes:FindFirstChild("Crouch")
end

local function SetPositionSpoof(char, hrp, hum, enabled)
	local collision = char:FindFirstChild("Collision")
	local collisionCrouch = collision and collision:FindFirstChild("CollisionCrouch")
	local crouchRemote = GetCrouchRemote()

	if enabled then
		char:SetAttribute("Hiding", true)
		if hum then
			hum:SetAttribute("Hiding", true)
		end
		if crouchRemote and crouchRemote:IsA("RemoteEvent") then
			pcall(function()
				crouchRemote:FireServer(true, true)
			end)
		end
		if hrp then
			hrp.CanCollide = false
		end
		if collision then
			collision.CanCollide = false
		end
		if collisionCrouch then
			collisionCrouch.CanCollide = false
		end
	else
		char:SetAttribute("Hiding", nil)
		if hum then
			hum:SetAttribute("Hiding", nil)
		end
		if crouchRemote and crouchRemote:IsA("RemoteEvent") then
			pcall(function()
				crouchRemote:FireServer(false, true)
			end)
		end
		if collision and hrp then
			collision.CFrame = hrp.CFrame
			collision.CanCollide = true
		end
		if collisionCrouch and hrp then
			collisionCrouch.CFrame = hrp.CFrame
			collisionCrouch.CanCollide = true
		end
	end
end

local function HandleTable(obj) 
	if not (obj:IsA("Model") and obj.Name == "Table") then 
		return 
	end 
	if obj:FindFirstChild("DrawerContainer", true) then 
		return 
	end 
	if obj:FindFirstChild("TableCanBeHided") then 
		return 
	end 
	
	for _, v in ipairs(obj:GetDescendants()) do 
		if v:IsA("BasePart") then 
			v.Transparency = 1 
		end 
	end 
	
	local Model = LoadModel( 
		"TableCanBeHided.txt", 
		"https://raw.githubusercontent.com/lynguyen26031993-design/-u/refs/heads/main/Place_131351567799504_Model_Table_1785589098.txt" 
	) 
	if not Model then 
		return 
	end 
	Model.Name = "TableCanBeHided" 
	Model.Parent = obj 
	if Model.PrimaryPart and obj.PrimaryPart then 
		Model:PivotTo(obj.PrimaryPart.CFrame) 	
	end 
	
	local Players = game:GetService("Players") 
	local LocalPlayer = Players.LocalPlayer 
	local RunService = game:GetService("RunService")
	
	for _, v in ipairs(Model:GetDescendants()) do 
		if v:IsA("ProximityPrompt") then 
			v.Triggered:Connect(function(player) 
				if player ~= LocalPlayer then 
					return 
				end 
				local char = LocalPlayer.Character 
				if not char then 
					return 
				end 
				
				v.Enabled = false 
				local hum = char:FindFirstChildOfClass("Humanoid") 
				local hrp = char:FindFirstChild("HumanoidRootPart") 
				if not hum or not hrp then 
					v.Enabled = true
					return 
				end 
				
				-- Đứng ở đâu thì khóa đứng im ngay chỗ đó, không dịch chuyển đi đâu cả
				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.AssemblyAngularVelocity = Vector3.zero
				hrp.Anchored = true
				
				-- Tắt va chạm phần thân
				for _, part in ipairs(char:GetDescendants()) do 	
					if part:IsA("BasePart") then 		
						part.CanCollide = false 	
					end 
				end 
				
				-- Bật ngay attribute Hiding & Position Spoof
				SetPositionSpoof(char, hrp, hum, true)
				
				local collision = char:FindFirstChild("Collision")
				local collisionCrouch = collision and collision:FindFirstChild("CollisionCrouch")
				
				local spoofCon = RunService.RenderStepped:Connect(function()
					if char:GetAttribute("Hiding") == true and hrp and hrp.Parent then
						local safeSpoofCF = CFrame.new(hrp.Position.X, hrp.Position.Y - 30, hrp.Position.Z)
						hrp.CanCollide = false
						if collision then
							collision.CFrame = safeSpoofCF
							collision.CanCollide = false
						end
						if collisionCrouch then
							collisionCrouch.CFrame = safeSpoofCF
							collisionCrouch.CanCollide = false
						end
					end
				end)
				
				-- Hiển thị hiệu ứng Vignette mờ tối và nút bấm thoát
				local hideClone, buttonClone 
				local exitRequested = false 
				
				pcall(function()
					for _, guiObj in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do 	
						if guiObj:IsA("ImageLabel") and guiObj.Name == "HideVignette" then 
							hideClone = guiObj:Clone() 
							hideClone.Name = "HideVignetteClone" 		
							hideClone.ImageTransparency = 0 		
							hideClone.Visible = true 		
							hideClone.Parent = guiObj.Parent 		
						elseif guiObj:IsA("ImageButton") and guiObj.Name == "ButtonUnhide" then 
							buttonClone = guiObj:Clone() 
							buttonClone.Name = "ButtonUnhideClone" 		
							buttonClone.Visible = true 		
							buttonClone.Parent = guiObj.Parent 		
							buttonClone.MouseButton1Click:Connect(function() 			
								exitRequested = true 		
							end) 	
						end 
					end 
				end)
				
				-- Đợi nhẹ để tránh nhận nhầm thao tác bấm prompt là lệnh di chuyển thoát ngay
				task.spawn(function()
					task.wait(0.15)
					while char.Parent and hrp.Parent and char:GetAttribute("Hiding") == true do
						task.wait(0.05)
						if hum.MoveDirection.Magnitude > 0 or exitRequested then
							break
						end
					end
					
					-- Tắt spoof & attribute Hiding
					if spoofCon then
						spoofCon:Disconnect()
						spoofCon = nil
					end
					
					SetPositionSpoof(char, hrp, hum, false)
					
					if buttonClone then buttonClone:Destroy() end 
					if hideClone then hideClone:Destroy() end 
					
					-- Mở khóa đứng im tại chỗ, không giật CFrame
					hrp.AssemblyLinearVelocity = Vector3.zero
					hrp.AssemblyAngularVelocity = Vector3.zero
					hrp.Anchored = false
					
					for _, part in ipairs(char:GetDescendants()) do 	
						if part:IsA("BasePart") then 		
							part.CanCollide = true 	
						end 
					end 
					
					v.Enabled = true 
				end)
			end) 
		end 
	end 
end 

for _, obj in ipairs(CurrentRooms:GetDescendants()) do 
	HandleTable(obj) 
end 

CurrentRooms.DescendantAdded:Connect(HandleTable)
